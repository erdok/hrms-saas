# ============================================================
# HRMS SaaS - Environment Variables Example
# ============================================================
# Copy to .env and fill with values from your Supabase project.
# For local Supabase (Docker) see README.md -> "Local Development".

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (public, browser-safe)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_local_anon_key

# Supabase (server-only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=replace_with_local_service_role_key

# Stripe (server-only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
