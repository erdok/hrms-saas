{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "incremental": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*",
        "./*"
      ],
      "@hrms/db": [
        "../../packages/db/src/index.ts"
      ],
      "@hrms/db/server": [
        "../../packages/db/src/server-index.ts"
      ],
      "@hrms/db/client": [
        "../../packages/db/src/client.ts"
      ],
      "@hrms/db/admin": [
        "../../packages/db/src/admin.ts"
      ],
      "@hrms/db/*": [
        "../../packages/db/src/*"
      ],
      "@hrms/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@hrms/types": [
        "../../packages/types/src/index.ts"
      ]
    },
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tests/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "e2e/**",
    "sentry.client.config.ts",
    "sentry.server.config.ts",
    "sentry.edge.config.ts",
    "lib/observability/sentry.ts",
    "components/locale-toggle.tsx",
    "app/api/stripe/**"
  ]
}
