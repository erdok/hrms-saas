# These are needed by Next.js at build/runtime (browser-side)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace-with-your-anon-key

# Server-only secrets (never prefixed with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
